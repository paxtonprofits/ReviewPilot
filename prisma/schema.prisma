generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// NextAuth v5 required models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  locations BusinessLocation[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ReviewPilot core models
model BusinessLocation {
  id         String   @id @default(cuid())
  userId     String
  name       String
  address    String?
  placeId    String?
  accountId  String?  // GBP account resource name
  locationId String?  // GBP location resource name
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?
  reviews      Review[]
  gbpToken     GbpToken?

  @@index([userId])
}

model GbpToken {
  id           String   @id @default(cuid())
  locationId   String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  location BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model Review {
  id             String       @id @default(cuid())
  locationId     String
  googleReviewId String       @unique
  reviewerName   String
  rating         Int
  comment        String?
  reviewDate     DateTime
  status         ReviewStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  location BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  response ReviewResponse?

  @@index([locationId])
  @@index([status])
}

enum ReviewStatus {
  PENDING
  APPROVED
  POSTED
  DISMISSED
}

model ReviewResponse {
  id          String    @id @default(cuid())
  reviewId    String    @unique
  content     String
  aiGenerated Boolean   @default(true)
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  locationId           String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  location BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

model OutreachProspect {
  id              String    @id @default(cuid())
  email           String    @unique
  firstName       String
  businessName    String
  city            String?
  emailStep       Int       @default(0)
  lastEmailSentAt DateTime?
  replied         Boolean   @default(false)
  unsubscribed    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([emailStep])
  @@index([unsubscribed])
}
